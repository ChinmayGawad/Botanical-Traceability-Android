# FloraChain Release Signing Configuration Template
# Copy this file to 'signing.properties' and fill in your actual credentials.
# 'signing.properties' and '*.jks' are ignored by Git.

RELEASE_STORE_FILE=florachain-release.jks
RELEASE_STORE_PASSWORD=your_keystore_password
RELEASE_KEY_ALIAS=your_key_alias
RELEASE_KEY_PASSWORD=your_key_password
